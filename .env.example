# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPCIONAL — somente servidor (nunca prefixe com NEXT_PUBLIC_).
# Usada apenas pela rota /api/equipe/convidar para enviar convite por e-mail a atendentes.
# Sem ela, convide pelo painel do Supabase (Authentication > Users > Invite).
SUPABASE_SERVICE_ROLE_KEY=

# OPCIONAL — somente para os testes de integração (npm run test:db).
# Use um projeto de TESTE/staging, nunca produção.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres do projeto de teste (npm run test:db)
TEST_DATABASE_URL=
